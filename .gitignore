# Build artifacts (Maven / Java)
target/
*.class
*.jar
*.war
*.ear
dependency-reduced-pom.xml
.flattened-pom.xml

# Native binaries bundled locally (do not commit ffmpeg/ffprobe/ffplay)
bin/*.exe
bin/*.dll
bin/*.so
bin/*.dylib

# Logs and runtime dumps
*.log
*.out
*.err
*_out.txt
hs_err_pid*
replay_pid*

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/

# IDE / editor
.idea/
*.iml
.classpath
.project
.settings/
.factorypath
.vscode/*.log
.cursor/

# Temporary / backup files
*.tmp
*.temp
*.bak
*.orig
*~

# Python cache / virtual envs
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/
.conda/

# Packaging outputs (create_installer.py / Inno Setup / jpackage)
installer/build/
installer/portable/
installer/output/
installer/jdk-cache/
installer/app-icon.ico
installer/app-icon-256.png
installer/installer_info.txt
installer/setup_script.iss
installer/*.exe
installer/*.zip

# Local packaging script and command dumps
create_installer.py
cp.txt
stderr_out.txt

# App local config/output (if generated outside source tree)
config.json
jobs-history.json
out/
dist/
